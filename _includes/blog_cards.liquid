{% comment %}
  Homepage blog teaser: one row per post = thumbnail + title + date + short description.
  The whole row links to the post page. Limit comes from page.latest_posts.limit in _pages/about.md.
{% endcomment %}
{% assign blog_limit = page.latest_posts.limit | default: 2 %}
<div class="blog-cards">
  {% for post in site.posts limit: blog_limit %}
    <a class="blog-card" href="{{ post.url | relative_url }}">
      <div class="row align-items-center">
        {% if post.thumbnail %}
          <div class="col-sm-4 mb-2 mb-sm-0">
            <img
              class="img-fluid rounded z-depth-1"
              src="{{ post.thumbnail | relative_url }}"
              alt="{{ post.title | escape }}"
              loading="lazy"
            >
          </div>
        {% endif %}
        <div class="{% if post.thumbnail %}col-sm-8{% else %}col-12{% endif %}">
          <h3 class="blog-card-title">{{ post.title }}</h3>
          <p class="blog-card-date">{{ post.date | date: '%b %Y' }}</p>
          <p class="blog-card-desc">{{ post.description }}</p>
        </div>
      </div>
    </a>
  {% endfor %}
  {% if site.posts.size > blog_limit %}
    <p class="text-right"><a href="{{ '/blog/' | relative_url }}">All posts &rarr;</a></p>
  {% endif %}
</div>

<style>
  .blog-card {
    display: block;
    color: inherit;
    padding: 0.75rem 0;
  }
  .blog-card:hover {
    text-decoration: none;
    color: inherit;
  }
  .blog-card:hover .blog-card-title {
    color: var(--global-theme-color);
  }
  .blog-card-title {
    font-size: 1.15rem;
    margin: 0 0 0.25rem 0;
  }
  .blog-card-date {
    font-size: 0.85rem;
    color: var(--global-text-color-light);
    margin: 0 0 0.4rem 0;
  }
  .blog-card-desc {
    margin: 0;
  }
</style>
